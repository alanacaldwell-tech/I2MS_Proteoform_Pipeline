@page "/"
@inject IonCounterService IonCounter
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container">
    <header class="app-header">
        <h1>I2MS Proteoform Ion Counter</h1>
        <p class="subtitle">Provide file paths below to count ions within each centroid window.</p>
    </header>

    <!-- Step 1: CSV path -->
    <section class="card">
        <h2><span class="step">1</span> Reference CSV file</h2>
        <p class="hint">First column: centroid mass (Da) &middot; Second column: tolerance &plusmn; (Da)</p>
        <input class="path-input @(csvError is not null ? "input-error" : "")"
               type="text"
               placeholder="e.g. C:\Users\YourName\Documents\centroids.csv"
               @bind="csvPath"
               @bind:event="oninput" />
        @if (csvError is not null)
        {
            <p class="error">@csvError</p>
        }
    </section>

    <!-- Step 2: DMT folder path -->
    <section class="card">
        <h2><span class="step">2</span> Folder containing .dmt files</h2>
        <p class="hint">Each .dmt file in this folder becomes one column in the output.</p>
        <input class="path-input @(dmtError is not null ? "input-error" : "")"
               type="text"
               placeholder="e.g. C:\Users\YourName\Documents\DMT_Files"
               @bind="dmtFolder"
               @bind:event="oninput" />
        @if (dmtError is not null)
        {
            <p class="error">@dmtError</p>
        }
    </section>

    <!-- Run -->
    <section class="card run-section">
        <button class="btn-run" @onclick="RunAsync" disabled="@(!CanRun)">
            @if (isRunning)
            {
                <span class="spinner"></span>
                <span>Processing&hellip;</span>
            }
            else
            {
                <span>&#9654; Run</span>
            }
        </button>

        @if (isRunning)
        {
            <div class="progress-bar-wrap">
                <div class="progress-bar-fill" style="width:@(ProgressPercent)%"></div>
            </div>
            <p class="progress-label">@progressMessage</p>
        }
    </section>

    <!-- Results -->
    @if (result is not null)
    {
        <section class="card result-section @(result.Success ? "success" : "failure")">
            @if (result.Success)
            {
                <h2>&#10004; Complete</h2>
                <div class="table-scroll">
                    <table class="summary-table">
                        <thead>
                            <tr>
                                <th class="col-sticky">Centroid (Da)</th>
                                <th class="col-sticky col-sticky-2">Tolerance &plusmn; (Da)</th>
                                @foreach (var name in result.DmtFileNames)
                                {
                                    <th>@name</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in result.Rows)
                            {
                                <tr>
                                    <td class="col-sticky">@row.Centroid.ToString("G")</td>
                                    <td class="col-sticky col-sticky-2">@row.Tolerance.ToString("G")</td>
                                    @for (int i = 0; i < row.Counts.Count; i++)
                                    {
                                        <td>@row.Counts[i].ToString("N0")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button class="btn-download" @onclick="DownloadResult">
                    &#11015; Download @result.OutputFileName
                </button>
            }
            else
            {
                <h2>&#10006; Error</h2>
                <p class="error">@result.ErrorMessage</p>
            }
        </section>

        <section class="card log-section">
            <h2>Log</h2>
            <pre class="log-box">@string.Join("\n", result.Log)</pre>
        </section>
    }
</div>

@code {
    private string  csvPath       = "";
    private string  dmtFolder     = "";
    private string? csvError;
    private string? dmtError;

    private bool    isRunning;
    private int     progressCurrent;
    private int     progressTotal   = 1;
    private string  progressMessage = "";

    private ProcessResult? result;
    private byte[]?        resultBytes;

    private bool CanRun => !string.IsNullOrWhiteSpace(csvPath)
                        && !string.IsNullOrWhiteSpace(dmtFolder)
                        && !isRunning;

    private double ProgressPercent =>
        progressTotal == 0 ? 0 : Math.Round((double)progressCurrent / progressTotal * 100, 1);

    private bool Validate()
    {
        csvError = dmtError = null;
        bool ok = true;

        if (!File.Exists(csvPath.Trim()))
        {
            csvError = "File not found. Check the path and try again.";
            ok = false;
        }

        if (!Directory.Exists(dmtFolder.Trim()))
        {
            dmtError = "Folder not found. Check the path and try again.";
            ok = false;
        }

        return ok;
    }

    private async Task RunAsync()
    {
        if (!CanRun || !Validate()) return;

        isRunning       = true;
        result          = null;
        resultBytes     = null;
        progressCurrent = 0;
        progressTotal   = 1;
        progressMessage = "Starting…";
        StateHasChanged();

        try
        {
            var prog = new Progress<(int current, int total, string message)>(p =>
            {
                progressCurrent = p.current;
                progressTotal   = p.total == 0 ? 1 : p.total;
                progressMessage = p.message;
                InvokeAsync(StateHasChanged);
            });

            result = await IonCounter.RunAsync(csvPath.Trim(), dmtFolder.Trim(), prog);

            if (result.Success)
                resultBytes = result.OutputCsvBytes;
        }
        catch (Exception ex)
        {
            result = new ProcessResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task DownloadResult()
    {
        if (resultBytes is null || result is null) return;
        var b64 = Convert.ToBase64String(resultBytes);
        await JS.InvokeVoidAsync("downloadBase64File", result.OutputFileName, "text/csv", b64);
    }
}
