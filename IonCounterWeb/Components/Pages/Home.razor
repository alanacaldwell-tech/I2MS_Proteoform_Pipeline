@page "/"
@inject IonCounterService IonCounter
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container">
    <header class="app-header">
        <h1>I2MS Proteoform Ion Counter</h1>
        <p class="subtitle">Upload a reference CSV and .dmt files to count ions within each centroid window.</p>
    </header>

    <!-- Step 1: CSV -->
    <section class="card">
        <h2><span class="step">1</span> Reference CSV file</h2>
        <p class="hint">First column: centroid mass (Da) &middot; Second column: tolerance &plusmn; (Da)</p>
        <InputFile OnChange="OnCsvSelected" accept=".csv" class="file-input" id="csvInput" />
        <label for="csvInput" class="file-label @(csvReady ? "ready" : "")">
            @(csvFileName ?? "Choose CSV file…")
        </label>
        @if (csvError is not null)
        {
            <p class="error">@csvError</p>
        }
    </section>

    <!-- Step 2: DMT files -->
    <section class="card">
        <h2><span class="step">2</span> .dmt files</h2>
        <p class="hint">Select one or more .dmt database files. Each file becomes one column in the output.</p>
        <InputFile OnChange="OnDmtSelected" accept=".dmt" multiple class="file-input" id="dmtInput" />
        <label for="dmtInput" class="file-label @(dmtFiles.Count > 0 ? "ready" : "")">
            @(dmtFiles.Count == 0 ? "Choose .dmt files…" : $"{dmtFiles.Count} file(s) selected")
        </label>
        @if (dmtFiles.Count > 0)
        {
            <ul class="file-list">
                @foreach (var f in dmtFiles)
                {
                    <li>@f.Name <span class="file-size">(@FormatBytes(f.Size))</span></li>
                }
            </ul>
        }
    </section>

    <!-- Run -->
    <section class="card run-section">
        <button class="btn-run" @onclick="RunAsync" disabled="@(!CanRun)">
            @if (isRunning)
            {
                <span class="spinner"></span>
                <span>Processing&hellip;</span>
            }
            else
            {
                <span>&#9654; Run</span>
            }
        </button>

        @if (isRunning)
        {
            <div class="progress-bar-wrap">
                <div class="progress-bar-fill" style="width:@(ProgressPercent)%"></div>
            </div>
            <p class="progress-label">@progressMessage</p>
        }
    </section>

    <!-- Results -->
    @if (result is not null)
    {
        <section class="card result-section @(result.Success ? "success" : "failure")">
            @if (result.Success)
            {
                <h2>&#10004; Complete</h2>
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Centroid (Da)</th>
                            <th>Tolerance &plusmn; (Da)</th>
                            <th>Total ions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in result.Summary)
                        {
                            <tr>
                                <td>@row.Centroid.ToString("G")</td>
                                <td>@row.Tolerance.ToString("G")</td>
                                <td>@row.TotalCount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="btn-download" @onclick="DownloadResult">
                    &#11015; Download @result.OutputFileName
                </button>
            }
            else
            {
                <h2>&#10006; Error</h2>
                <p class="error">@result.ErrorMessage</p>
            }
        </section>

        <section class="card log-section">
            <h2>Log</h2>
            <pre class="log-box">@string.Join("\n", result.Log)</pre>
        </section>
    }
</div>

@code {
    private IBrowserFile?        csvFile;
    private string?              csvFileName;
    private string?              csvError;
    private bool                 csvReady;

    private List<IBrowserFile>   dmtFiles = new();

    private bool                 isRunning;
    private int                  progressCurrent;
    private int                  progressTotal = 1;
    private string               progressMessage = "";

    private ProcessResult?       result;
    private byte[]?              resultBytes;

    private bool CanRun => csvReady && dmtFiles.Count > 0 && !isRunning;

    private double ProgressPercent =>
        progressTotal == 0 ? 0 : Math.Round((double)progressCurrent / progressTotal * 100, 1);

    private void OnCsvSelected(InputFileChangeEventArgs e)
    {
        csvError    = null;
        csvReady    = false;
        csvFile     = e.File;
        csvFileName = e.File.Name;

        if (!csvFileName.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            csvError = "Please select a .csv file.";
            return;
        }
        csvReady = true;
    }

    private void OnDmtSelected(InputFileChangeEventArgs e)
    {
        dmtFiles = e.GetMultipleFiles(maximumFileCount: 500).ToList();
    }

    private async Task RunAsync()
    {
        if (!CanRun || csvFile is null) return;

        isRunning       = true;
        result          = null;
        resultBytes     = null;
        progressCurrent = 0;
        progressTotal   = dmtFiles.Count;
        progressMessage = "Starting…";
        StateHasChanged();

        try
        {
            await using var csvStream = csvFile.OpenReadStream(IonCounterService.MaxFileSizeBytes);

            var dmtStreams = new List<(Stream Data, string Name)>();
            foreach (var f in dmtFiles)
                dmtStreams.Add((f.OpenReadStream(IonCounterService.MaxFileSizeBytes), f.Name));

            var prog = new Progress<(int current, int total, string message)>(p =>
            {
                progressCurrent = p.current;
                progressTotal   = p.total == 0 ? 1 : p.total;
                progressMessage = p.message;
                InvokeAsync(StateHasChanged);
            });

            result = await IonCounter.RunAsync(csvStream, csvFile.Name, dmtStreams, prog);

            if (result.Success)
                resultBytes = result.OutputCsvBytes;
        }
        catch (Exception ex)
        {
            result = new ProcessResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task DownloadResult()
    {
        if (resultBytes is null || result is null) return;
        var b64 = Convert.ToBase64String(resultBytes);
        await JS.InvokeVoidAsync("downloadBase64File", result.OutputFileName, "text/csv", b64);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024L)
            return $"{bytes} B";
        if (bytes < 1024L * 1024)
            return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024)
            return $"{bytes / 1024.0 / 1024:F1} MB";
        return $"{bytes / 1024.0 / 1024 / 1024:F2} GB";
    }
}
